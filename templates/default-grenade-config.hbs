{{#*inline "fileRow"}}
<li class="dialog-item flexrow">
    <div class="dialog-item-name">{{label}}</div>
    <div class="dialog-item-input mmg-file-input">
        <input type="text" name="effects.{{key}}" value="{{value}}">
        <button type="button" class="file-picker" data-type="{{type}}" data-target="effects.{{key}}" data-tooltip="Browse Files"><i class="fas fa-file-import fa-fw"></i></button>
    </div>
</li>
{{/inline}}
{{#*inline "numberRow"}}
<li class="dialog-item flexrow">
    <div class="dialog-item-name">{{label}}</div>
    <div class="dialog-item-input">
        <input type="number" name="effects.{{key}}" value="{{value}}" min="{{min}}" max="{{max}}" step="0.1">
    </div>
</li>
{{/inline}}
<form class="dialog-sheet mmg-config" autocomplete="off">
    <nav class="cpr-tabs nav text-semi mmg-config-tabs" data-group="primary">
        <div class="tab-pink-underlay"><a class="tab-label text-small tab-indent" data-tab="colors">Colors</a></div>
        <div class="tab-pink-underlay"><a class="tab-label text-small tab-indent" data-tab="explosion">Explosion</a></div>
        <div class="tab-pink-underlay"><a class="tab-label text-small tab-indent" data-tab="emp">{{localize "CPR.global.ammo.type.emp"}}</a></div>
        <div class="tab-pink-underlay"><a class="tab-label text-small tab-indent" data-tab="flashbang">{{localize "CPR.global.ammo.type.flashBang"}}</a></div>
        <div class="tab-pink-underlay"><a class="tab-label text-small tab-indent" data-tab="smoke">{{localize "CPR.global.ammo.type.smoke"}}</a></div>
    </nav>

    <section class="mmg-config-content">
        <div class="tab" data-group="primary" data-tab="colors">
            <ol class="dialog-list">
                <li class="dialog-item dialog-item-header flexrow">
                    <div class="dialog-item-name">{{localize "CPR.global.generic.type"}}</div>
                    <div class="dialog-item-input">Template Color</div>
                </li>
                {{#each colorList}}
                <li class="dialog-item flexrow">
                    <div class="dialog-item-name">{{this.label}}</div>
                    <div class="dialog-item-input"><input type="color" name="colors.{{this.key}}" value="{{this.value}}"></div>
                </li>
                {{/each}}
            </ol>
        </div>

        <div class="tab" data-group="primary" data-tab="explosion">
            <ol class="dialog-list">
                <li class="dialog-item dialog-item-header flexrow">
                    <div class="dialog-item-name">Explosion</div>
                </li>
                <li class="dialog-item flexrow mmg-hint-row">
                    <div class="dialog-item-name text-small">Used for every grenade except EMP, Flashbang and Smoke.</div>
                </li>
                {{> fileRow label="Animation File" key="explosionAnimation" value=effects.explosionAnimation type="imagevideo"}}
                {{> numberRow label="Scale" key="explosionScale" value=effects.explosionScale min="0.1" max="3"}}
                {{> fileRow label="Sound File" key="explosionSound" value=effects.explosionSound type="audio"}}
                {{> numberRow label="Volume (0 to 1)" key="explosionVolume" value=effects.explosionVolume min="0" max="1"}}
            </ol>
        </div>

        <div class="tab" data-group="primary" data-tab="emp">
            <ol class="dialog-list">
                <li class="dialog-item dialog-item-header flexrow"><div class="dialog-item-name">Explosion</div></li>
                {{> fileRow label="Animation File" key="empCenterAnimation" value=effects.empCenterAnimation type="imagevideo"}}
                {{> numberRow label="Scale" key="empCenterScale" value=effects.empCenterScale min="0.1" max="3"}}
                <li class="dialog-item dialog-item-header flexrow"><div class="dialog-item-name">On Affected Tokens</div></li>
                {{> fileRow label="Animation File" key="empAnimation" value=effects.empAnimation type="imagevideo"}}
                {{> numberRow label="Scale" key="empScale" value=effects.empScale min="0.1" max="3"}}
                <li class="dialog-item dialog-item-header flexrow"><div class="dialog-item-name">Sound</div></li>
                {{> fileRow label="Sound File" key="empSound" value=effects.empSound type="audio"}}
                {{> numberRow label="Volume (0 to 1)" key="empVolume" value=effects.empVolume min="0" max="1"}}
            </ol>
        </div>

        <div class="tab" data-group="primary" data-tab="flashbang">
            <ol class="dialog-list">
                <li class="dialog-item dialog-item-header flexrow"><div class="dialog-item-name">Explosion</div></li>
                {{> fileRow label="Animation File" key="flashbangCenterAnimation" value=effects.flashbangCenterAnimation type="imagevideo"}}
                {{> numberRow label="Scale" key="flashbangCenterScale" value=effects.flashbangCenterScale min="0.1" max="3"}}
                <li class="dialog-item dialog-item-header flexrow"><div class="dialog-item-name">On Affected Tokens</div></li>
                {{> fileRow label="Animation File" key="flashbangAnimation" value=effects.flashbangAnimation type="imagevideo"}}
                {{> numberRow label="Scale" key="flashbangScale" value=effects.flashbangScale min="0.1" max="3"}}
                <li class="dialog-item dialog-item-header flexrow"><div class="dialog-item-name">Sound</div></li>
                {{> fileRow label="Sound File" key="flashbangSound" value=effects.flashbangSound type="audio"}}
                {{> numberRow label="Volume (0 to 1)" key="flashbangVolume" value=effects.flashbangVolume min="0" max="1"}}
            </ol>
        </div>

        <div class="tab" data-group="primary" data-tab="smoke">
            <ol class="dialog-list">
                <li class="dialog-item dialog-item-header flexrow"><div class="dialog-item-name">{{localize "CPR.global.ammo.type.smoke"}}</div></li>
                {{> fileRow label="Animation File" key="smokeAnimation" value=effects.smokeAnimation type="imagevideo"}}
                {{> numberRow label="Scale" key="smokeScale" value=effects.smokeScale min="0.1" max="3"}}
            </ol>
        </div>
    </section>

    <div class="dialog-footer flexrow">
        <button type="submit" class="cpr-dialog-button"><i class="fas fa-floppy-disk"></i> {{localize "CPR.settings.saveSettings"}}</button>
    </div>
</form>
