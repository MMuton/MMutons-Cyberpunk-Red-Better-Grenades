{{#*inline "entry"}}
<li class="dialog-item grenade-entry">
    <div class="flexrow mmg-entry-row">
        <input type="text" class="grenade-name" value="{{name}}" placeholder="{{localize "CPR.global.generic.name"}}">
        <input type="color" class="grenade-color" value="{{color}}" data-tooltip="Template Color">
        <label class="mmg-entry-option"><input type="checkbox" class="delete-template" {{#if deleteTemplate}}checked{{/if}}> Delete Template</label>
        <label class="mmg-entry-option">Scale <input type="number" class="tile-scale" value="{{tileScale}}" min="0.1" max="10" step="0.1"></label>
        <a class="expand-btn mmg-entry-icon" data-tooltip="Show or hide code"><i class="fas fa-code"></i></a>
        <a class="delete-grenade-btn mmg-entry-icon" data-tooltip="Delete"><i class="fas fa-trash-can"></i></a>
    </div>
    <div class="grenade-code-section" style="display: none;">
        <textarea class="grenade-code" rows="10" placeholder="Custom JavaScript for this grenade">{{code}}</textarea>
        <div class="text-small mmg-code-help">
            Variables: <code>grenadeName</code>, <code>actor</code>, <code>token</code>, <code>targets</code>, <code>templates</code>, <code>config</code>, <code>GrenadeSystem</code>.
            Helpers include <code>GrenadeSystem.createScaledTile()</code>, <code>GrenadeSystem.applyCPRDamage()</code> and <code>GrenadeSystem.firstExistingFile()</code>.
        </div>
    </div>
</li>
{{/inline}}
<form class="dialog-sheet mmg-config special-grenade-config-form" autocomplete="off">
    <div class="dialog-header flexcol">
        <div class="text-center text-small">Custom effects for grenades whose ammo type is "{{localize "CPR.global.ammo.type.special"}}". Entries match the grenade's item name. Custom code runs on the GM's client.</div>
    </div>
    <hr/>
    <div class="dialog-grid flexcol">
        <ol class="dialog-list">
            <li class="dialog-item dialog-item-header flexrow">
                <div class="dialog-item-name">Built-In Handlers</div>
            </li>
            {{#each builtInGrenades}}
            <li class="dialog-item flexrow">
                <div class="dialog-item-name text-small"><span class="text-semi">{{name}}</span>: {{description}}</div>
            </li>
            {{/each}}
        </ol>
    </div>
    <div class="dialog-grid flexcol">
        <ol class="dialog-list grenade-list">
            <li class="dialog-item dialog-item-header flexrow mmg-list-header">
                <div class="dialog-item-name">Custom Grenades</div>
                <div class="dialog-item-input">
                    <a class="add-grenade-btn" data-tooltip="{{localize "CPR.global.generic.add"}}"><i class="fas fa-plus"></i> {{localize "CPR.global.generic.add"}}</a>
                </div>
            </li>
            {{#each grenades}}
            {{> entry this}}
            {{/each}}
        </ol>
    </div>

    <template class="grenade-entry-template">{{> entry blank}}</template>

    <div class="dialog-footer flexrow">
        <button type="button" class="cpr-dialog-button save-config-btn"><i class="fas fa-floppy-disk"></i> {{localize "CPR.settings.saveSettings"}}</button>
        <button type="button" class="cpr-dialog-button save-close-btn"><i class="fas fa-check"></i> {{localize "CPR.dialog.common.confirm"}}</button>
    </div>
</form>
